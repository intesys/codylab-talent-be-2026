### ==========================================
### AUTH - Registrazione
### ==========================================

### Registrazione nuovo utente (201)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "name": "Mario",
  "surname": "Rossi",
  "username": "mario.rossi.test",
  "password": "Password1!",
  "confirmPassword": "Password1!"
}

### Registrazione - password non coincidono (400)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "mario.rossi2",
  "password": "Password1!",
  "confirmPassword": "DifferentPass1!"
}

### Registrazione - username mancante (400)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "password": "Password1!",
  "confirmPassword": "Password1!"
}

### Registrazione - password debole (400)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "mario.rossi3",
  "password": "weak",
  "confirmPassword": "weak"
}

### Registrazione - body vuoto (400)
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{}

### ==========================================
### AUTH - Login
### ==========================================

### Login con utente seed esistente (200)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "mrossi",
  "password": "Password1!"
}

### Login - password errata (401)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "mrossi",
  "password": "WrongPass1!"
}

### Login - utente inesistente (401)
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "nonexistent",
  "password": "Password1!"
}

### Login con Basic auth (mrossi:password1)
POST {{baseUrl}}/api/v1/auth/login
Authorization: Basic bXJvc3NpOnBhc3N3b3JkMQ==
Content-Type: application/json

{
  "username": "mrossi",
  "password": "password1"
}

### ==========================================
### NOTA: Dopo aver eseguito il login, copia
### il campo "accessToken" dalla risposta e
### aggiorna la variabile @authToken qui sopra.
### ==========================================

### ==========================================
### PROJECTS (protette - richiedono token)
### Endpoint disponibili:
###   - /api/v1/projects (OpenAPI)
###   - /projects         (plain ProjectController)
### ==========================================

### --- /projects (plain) ---

### GET tutti i progetti (200)
GET {{baseUrl}}/projects
Authorization: Bearer {{authToken}}

### GET progetto per ID (200)
GET {{baseUrl}}/projects/1
Authorization: Bearer {{authToken}}

### GET progetto inesistente (404)
GET {{baseUrl}}/projects/999
Authorization: Bearer {{authToken}}

### POST crea nuovo progetto (201)
POST {{baseUrl}}/projects
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Nuovo Progetto",
  "description": "Progetto creato per test",
  "estimatedHours": 120,
  "status": "CREATED",
  "startDate": "2026-07-01",
  "endDate": "2026-09-30"
}

### PUT aggiorna progetto (200)
PUT {{baseUrl}}/projects/1
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "CRM Aziendale - Aggiornato",
  "description": "Descrizione aggiornata del progetto",
  "estimatedHours": 350,
  "status": "WORKING",
  "startDate": "2026-06-03",
  "endDate": "2026-09-30"
}

### PUT progetto inesistente (404)
PUT {{baseUrl}}/projects/999
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Inesistente",
  "description": "Questo progetto non esiste",
  "estimatedHours": 100,
  "status": "CREATED",
  "startDate": "2026-07-01",
  "endDate": "2026-08-01"
}

### DELETE elimina progetto (200)
DELETE {{baseUrl}}/projects/7
Authorization: Bearer {{authToken}}

### DELETE progetto inesistente (404)
DELETE {{baseUrl}}/projects/999
Authorization: Bearer {{authToken}}

### --- /api/v1/projects (OpenAPI) ---

### GET tutti i progetti via OpenAPI (200)
GET {{baseUrl}}/api/v1/projects
Authorization: Bearer {{authToken}}

### GET progetto per ID via OpenAPI (200)
GET {{baseUrl}}/api/v1/projects/1
Authorization: Bearer {{authToken}}

### POST crea nuovo progetto via OpenAPI (200/201)
POST {{baseUrl}}/api/v1/projects
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Nuovo Progetto OpenAPI",
  "description": "Tramite controller OpenAPI",
  "estimatedHours": 80,
  "status": "CREATED",
  "startDate": "2026-07-15",
  "endDate": "2026-09-15"
}

